# Copy to .env and fill in.

# API keys. Paste them in the panel (Settings → API keys; stored encrypted, master key in Windows Credential Manager),
# or put them here / in the environment for headless setups. The panel's saved key wins; a value here never overrides
# a variable that is already set in the environment.
OPENROUTER_API_KEY=
# The Anthropic API directly for the brain roles (planner, smart, browser, fast): pick an "anthropic-api/..." model in
# Settings → Models. Jev, Perplexity and Gemini always go through OpenRouter.
ANTHROPIC_API_KEY=
# On a server without a credential store, set a master key instead (32 random bytes, base64):
# FLEET_MASTER_KEY=

# Database. "embedded": Fleet starts its own Postgres under data/pg (needs the pgserver package: pip install pgserver).
# Or your own server; Fleet creates the "fleet" database on first start.
FLEET_DATABASE_URL=embedded
# FLEET_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fleet

# AdsPower Local API (AdsPower → Settings → API). Optional: Fleet also drives local Chrome profiles of its own
# (`fleet profiles add-local <name>`, or Profiles → Add a local profile).
FLEET_ADSPOWER_URL=http://local.adspower.net:50325
# The browser for local profiles. Empty = the first Chrome or Edge found.
# FLEET_BROWSER_EXE=C:\Program Files\Google\Chrome\Application\chrome.exe

# Set this before exposing the panel beyond this computer.
FLEET_API_TOKEN=
# The API only answers to localhost. Add hostnames here if you serve it elsewhere (comma-separated).
FLEET_ALLOWED_HOSTS=

# Readiness (READINESS.md): the most the live gates may spend in one `python -m readiness` run.
# FLEET_READINESS_BUDGET_USD=0.25

# Optional overrides
# FLEET_PORT=8710
# FLEET_WORKER_BROWSER_SLOTS=4
# FLEET_WORKER_WEB_SLOTS=6
# FLEET_MAX_BROWSER_STEPS=60
# FLEET_HUMAN_WAIT_SECONDS=1800
# FLEET_CLOSE_BROWSER_AFTER_SUBTASK=true
# Scraping and crawling limits (per step):
# FLEET_SCRAPE_MAX_PAGES=10
# FLEET_SCRAPE_MAX_ITEMS=300
# FLEET_SCRAPE_MAX_DETAILS=30
# FLEET_SCRAPE_MAX_SECONDS=300
# FLEET_CRAWL_MAX_PAGES=50
# FLEET_CRAWL_MAX_DEPTH=3
# FLEET_CRAWL_MAX_SECONDS=300
# FLEET_FETCH_MIN_DELAY_SECONDS=2.0
# Accounts Fleet may create for you in 24 hours (each one is approved in the Inbox):
# FLEET_REGISTRATIONS_PER_DAY=3
# Clean up screenshots, histories and step logs of finished tasks older than this many days (0 = keep everything):
# FLEET_RETENTION_DAYS=0
